# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Data source (Stage 1) ---
DATA_SOURCE=yfinance
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
TWELVEDATA_API_KEY=

# --- Sentiment data (IG Client Sentiment) ---
# Free to use with a demo IG account (no funding needed). Sign up at
# labs.ig.com to get an API key. Used as a contrarian overlay on top of the
# candlestick pattern score — see data/sentiment.py.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ENV=demo
# How much weight sentiment gets when blended into the live score (0..1).
# 0 = ignore sentiment entirely. Kept modest by default so it nudges rather
# than overrides the pattern/context score. Only applies in --mode live,
# never to replay/backtest bars (sentiment has no history). See
# engine/confidence.py.
SENTIMENT_WEIGHT=0.2

# --- Institutional positioning (CFTC Commitment of Traders) ---
# Free, no signup or API key needed — public CFTC Socrata endpoint
# (publicreporting.cftc.gov). Weekly "Legacy Futures Only" report,
# large-speculator (non-commercial) net positioning per currency, turned
# into a "COT Index" (0-100 percentile of the net position within its own
# trailing ~3-year range) and rescaled to -100..+100. Unlike IG sentiment
# this is NOT contrarian — it reports institutions' own directional lean.
# See data/cot.py. Like sentiment, only applies in --mode live, never to
# replay/backtest bars.
COT_WEIGHT=0.15
# Extra conviction (or penalty) applied when retail sentiment and COT
# positioning agree (or disagree) in direction — see
# engine/confidence.py's retail_institutional_divergence(). 0 disables it.
COT_DIVERGENCE_BONUS=0.2

# --- Instruments to watch ---
# FX majors + JPY diversification + US30 index. Tickers are yfinance-style;
# OANDA codes and price-scale knobs live in data/instruments.py.
PAIRS=EURUSD=X,GBPUSD=X,USDJPY=X,GBPJPY=X,^DJI
TIMEFRAMES=1h,4h

# --- Trend policy (Stage 3) ---
# "ignore_short": trade only with the long-term (HTF) trend; short-term
#   counter-moves are treated as noise and suppressed.
# "fade_early": also allow young + strong short-term counter-trend moves
#   through at a discount, before they've had time to be widely noticed.
COUNTER_TREND_POLICY=ignore_short

# --- Delivery (Stage 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Execution (Stage 7) ---
# MUST stay false until you intentionally go live. Dry-run is used otherwise.
EXECUTE_ENABLED=false
# Optional hard stop — blocks all new orders when true
EXEC_KILL_SWITCH=false
# Risk controls
RISK_PER_TRADE=0.01
MAX_UNITS=1000
EXEC_MIN_SCORE=50
MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=5
DEFAULT_EQUITY=10000


# --- Auto-scan (recurring engine refresh) ---
# Reruns the signal engine on a fixed timer inside the container so
# signals, pair bias, and the ML model keep working off fresh data
# without anyone clicking "Scan now". Runs the same code path as the
# manual scan button. See api/main.py:_auto_scan_loop.
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_SEC=3600
AUTO_SCAN_MODE=replay
AUTO_SCAN_TIMEFRAME=1h
AUTO_SCAN_PERIOD=5d
# Leave blank to scan the full watchlist (PAIRS) each pass.
AUTO_SCAN_PAIR=
# Optional: also fire one extra pass immediately on container boot, in
# addition to the recurring loop above.
AUTO_SCAN_ON_START=false

# --- ML auto-retrain (fired signals + win/loss labels) ---
# Retrains GradientBoosting on closed outcomes after Scan, outcome labels,
# and on a background interval. Debounced by min new labels + cooldown.
ML_AUTO_RETRAIN=true
ML_MIN_SAMPLES=12
ML_MIN_NEW_LABELS=3
ML_RETRAIN_COOLDOWN_SEC=60
ML_RETRAIN_INTERVAL_SEC=300

# --- ML Health Manager (over / under-fitting control) ---
# Train accuracy − walk-forward accuracy above this → "overfitting"
# (auto-retrain pauses, hyper-params regularise, explore mode on).
ML_OVERFIT_GAP=0.18
# Both train and walk-forward accuracy below this → "underfitting"
# (explore mode + more aggressive trees).
ML_UNDERFIT_ACC=0.52
# Hours since last fit before model is marked "stale".
ML_STALE_HOURS=48
# Min distinct patterns with ≥2 samples to count as diverse.
ML_MIN_DIVERSITY_PATTERNS=3
